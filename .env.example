# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used for signing customer and admin JWT tokens
JWT_SECRET="trimplate_dev_secret_change_in_prod"

# VITE_API_BASE_URL: API base endpoint (defaults to /api; set to CodeIgniter 4 URL when deploying separately)
VITE_API_BASE_URL="/api"

# WHATSAPP_WEBHOOK_URL: Optional webhook endpoint (e.g. WhatsApp Cloud API bridge / Twilio / WATI) to auto-forward every new order non-blockingly
WHATSAPP_WEBHOOK_URL=""

